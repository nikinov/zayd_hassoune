# Absolute origin used for canonical URLs, Open Graph tags, robots.txt and the
# sitemap. Set this per environment — a canonical pointing at the wrong host
# will keep the deployed site out of the index.
PUBLIC_SITE_URL=https://www.zaydhassoune.com

# Optional endpoint the contact form POSTs its FormData to (Formspree, Brevo,
# HubSpot, a CRM webhook or your own function). Left empty, the form validates
# and confirms locally without sending anything.
PUBLIC_FORM_ENDPOINT=
