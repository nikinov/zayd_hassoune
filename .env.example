# Absolute origin used for canonical URLs, Open Graph tags, robots.txt and the
# sitemap. Set this per environment — a canonical pointing at the wrong host
# will keep the deployed site out of the index.
PUBLIC_SITE_URL=https://www.zaydhassoune.com

# Optional endpoint the contact form POSTs its FormData to (Formspree, Brevo,
# HubSpot, a CRM webhook or your own function). Left empty, the form validates
# and confirms locally without sending anything.
PUBLIC_FORM_ENDPOINT=

# Outbound mail. The contact form posts to /api/contact, which sends the
# enquiry through Brevo's transactional API — the same client and account the
# boat management app uses.
#   BREVO_API_KEY  v3 API key (Brevo > SMTP & API). Without it the endpoint
#                  logs the mail instead of sending, so the form still works
#                  locally.
#   EMAIL_FROM     sender; the domain must be authenticated in Brevo
#   CONTACT_TO     where enquiries land
#   EMAIL_DISABLED set to 1 to log instead of send even with a key configured
BREVO_API_KEY=
EMAIL_FROM=Zayd Hassoune <no-reply@boat.nicholasnovelle.com>
CONTACT_TO=contact@zaydhassoune.com
EMAIL_DISABLED=
